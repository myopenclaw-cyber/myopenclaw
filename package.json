{
  "name": "myopenclaw",
  "version": "0.1.0",
  "description": "MyOpenClaw - Desktop client for OpenClaw",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:release:win": "powershell -ExecutionPolicy Bypass -File ./build-release.ps1 -Platform win",
    "build:release:mac": "bash ./build-release.sh mac"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.myopenclaw.app",
    "productName": "MyOpenClaw",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "setup.html",
      "loading.html",
      "start-myopenclaw.cmd",
      "resources/gateway.cmd",
      "resources/openclaw-deps/**/*",
      "resources/.openclaw-myopenclaw/openclaw.json",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
