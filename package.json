{
  "name": "myopenclaw",
  "version": "0.3.34",
  "description": "MyOpenClaw - Desktop client for OpenClaw",
  "main": "main.js",
  "scripts": {
    "build:ts": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build:ts",
    "start": "npm run build:ts && electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:release:win": "powershell -ExecutionPolicy Bypass -File ./build-release.ps1 -Platform win",
    "build:release:mac": "bash ./build-release.sh mac",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "@types/ws": "^8.18.1",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.myopenclaw.app",
    "productName": "MyOpenClaw",
    "protocols": [
      {
        "name": "MyOpenClaw",
        "schemes": [
          "myopenclaw"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "setup.html",
      "loading.html",
      "error.html",
      "start-myopenclaw.cmd",
      "resources/gateway.cmd",
      "resources/gateway.sh",
      "resources/openclaw-deps/**/*",
      "resources/.openclaw-myopenclaw/openclaw.json",
      "assets/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
