{
  "appId": "com.myopenclaw.app",
  "productName": "MyOpenClaw",
  "artifactName": "${productName}-${version}-${env.BUILD_VARIANT}-${arch}.${ext}",
  "files": [
    "main.js",
    "preload.js",
    "index.html",
    "setup.html",
    "loading.html",
    "error.html",
    "start-myopenclaw.cmd",
    "resources/gateway.cmd",
    "resources/gateway.sh",
    "resources/runtime-manifest.json",
    "resources/openclaw-deps/**/*",
    "resources/node/**/*",
    "resources/node-version.json",
    "resources/.openclaw-myopenclaw/openclaw.json",
    "assets/**/*",
    "build/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg"
      },
      {
        "target": "zip"
      }
    ]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "myopenclaw-cyber",
      "repo": "myopenclaw",
      "releaseType": "release"
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
